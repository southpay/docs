{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Southpay",
  "description": "Southpay is a crypto payment gateway. Accept crypto payments, settle in local currency, and automate payouts, refunds, subscriptions, and reconciliation through a single REST API.",
  "colors": {
    "primary": "#4253FE",
    "light": "#7C88FF",
    "dark": "#2E3BC7"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://docs.southpay.io"
  },
  "fonts": {
    "heading": {
      "family": "Inter Tight",
      "weight": 600
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "background": {
    "decoration": "gradient"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light-default",
        "dark": "github-dark-default"
      }
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "seo": {
    "metatags": {
      "og:type": "website",
      "og:site_name": "Southpay Documentation",
      "twitter:card": "summary_large_image"
    },
    "organization": {
      "name": "Southpay",
      "url": "https://southpay.io",
      "sameAs": [
        "https://github.com/southpay",
        "https://linkedin.com/company/southpay"
      ]
    },
    "indexing": "navigable"
  },
  "search": {
    "prompt": "Search payments, webhooks, payouts, and API reference"
  },
  "metadata": {
    "timestamp": true
  },
  "thumbnails": {
    "appearance": "dark",
    "fonts": {
      "family": "Inter Tight"
    }
  },
