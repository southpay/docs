{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Southpay",
  "colors": {
    "primary": "#4253FE",
    "light": "#4253FE",
    "dark": "#4253FE"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "icon": "book-open-cover",
          "href": "https://docs.southpay.io"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Guides",
        "pages": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart",
              "environments",
              "currencies"
            ]
          },
          {
            "group": "Authentication",
            "pages": [
              "authentication"
            ]
          },
          {
            "group": "Core Resources",
            "pages": [
              "payment-intents",
              "webhooks"
            ]
          },
          {
            "group": "Checkout widget",
            "pages": [
              "checkout-widget"
            ]
          },
          {
            "group": "OAuth Integrations",
            "pages": [
              "oauth-apps"
            ]
          },
          {
            "group": "Integration",
            "pages": [
              "idempotency",
              "errors",
              "best-practices"
            ]
          },
          {
            "group": "Changelog",
            "pages": [
              "changelog"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "pages": [
          {
            "group": "Payments",
            "pages": [
              "api-reference/payments",
              "api-reference/refunds",
              "api-reference/reconciliation"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "api-reference/webhook-endpoints"
            ]
          },
          {
            "group": "Balances",
            "pages": [
              "api-reference/balances"
            ]
          },
          {
            "group": "Payouts",
            "pages": [
              "api-reference/payouts",
              "api-reference/payout-schedules"
            ]
          },
          {
            "group": "Billing",
            "pages": [
              "api-reference/billing"
            ]
          },
          {
            "group": "Reports",
            "pages": [
              "api-reference/reports"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://docs.southpay.io"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@southpay.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://api.southpay.io"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/southpay",
      "linkedin": "https://linkedin.com/company/southpay"
    }
  },
  "appearance": {
    "strict": true,
    "default": "light"
  },
  "thumbnails": {
    "appearance": "light"
  },
  "banner": {
    "content": "SouthPay Documentation",
    "dismissible": false
  }
}