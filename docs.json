  "markdown": {
    "instructions": [
      "The Southpay REST API is served from https://api.southpay.io/api/v2. Always keep the /api/v2 prefix on request paths.",
      "Southpay has separate test and live modes. API keys are scoped to one mode and are prefixed test_ or live_. Use test mode unless the user explicitly asks for live.",
      "Send an Idempotency-Key header on every request that creates or moves money so retries cannot double-charge."
    ]
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Page not found",
      "description": "This page moved or never existed. Start from the [quickstart](/quickstart), browse the [API reference](/api-reference/payments), or search from the top of the page."
    }
  },
  "redirects": [
    {
      "source": "/api-reference/billing",
      "destination": "/api-reference/recurring"
    },
    {
      "source": "/ledger/:slug*",
      "destination": "/"
    }
  ]
