{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Southpay",
  "colors": {
    "primary": "#4253FE",
    "light": "#4253FE",
    "dark": "#4253FE"
  },
  "favicon": "/favicon.png",
  "seo": {
    "metatags": {
      "og:type": "website",
      "og:site_name": "Southpay Documentation",
      "og:image": "https://docs.southpay.io/images/hero-light.png",
      "twitter:card": "summary_large_image",
      "twitter:image": "https://docs.southpay.io/images/hero-light.png"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "pages": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart",
              "environments",
              "currencies"
            ]
          },
          {
            "group": "Authentication",
            "pages": [
              "authentication"
            ]
          },
          {
            "group": "Core Resources",
            "pages": [
              "payment-intents",
              "webhooks"
            ]
          },
          {
            "group": "Recurring",
            "pages": [
              "subscriptions"
            ]
          },
          {
            "group": "Checkout widget",
            "pages": [
              "checkout-widget"
            ]
          },
          {
            "group": "Agentic commerce",
            "pages": [
              "agentic/index",
              "agentic/quickstart",
              "agentic/agent-credentials",
              "agentic/authorization",
              "agentic/mcp-server",
              "agentic/x402"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "platform-accounts",
              "oauth-apps",
              "integrations/n8n"
            ]
          },
          {
            "group": "Integration",
            "pages": [
              "idempotency",
              "errors",
              "best-practices"
            ]
          },
          {
            "group": "Changelog",
            "pages": [
              "changelog"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "pages": [
          {
            "group": "Payments",
            "pages": [
              "api-reference/payments",
              "api-reference/refunds",
              "api-reference/reconciliation"
            ]
          },
          {
            "group": "Platform",
            "pages": [
              "api-reference/platform-accounts"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "api-reference/webhook-endpoints"
            ]
          },
          {
            "group": "Balances",
            "pages": [
              "api-reference/balances"
            ]
          },
          {
            "group": "Payouts",
            "pages": [
              "api-reference/payouts",
              "api-reference/payout-schedules"
            ]
          },
          {
            "group": "Agentic",
            "pages": [
              "api-reference/agentic"
            ]
          },
          {
            "group": "Invoicing",
            "pages": [
              "api-reference/invoicing"
            ]
          },
          {
            "group": "Recurring",
            "pages": [
              "api-reference/recurring"
            ]
          },
          {
            "group": "Reports",
            "pages": [
              "api-reference/reports"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "icon": "book-open-cover",
          "href": "https://docs.southpay.io"
        }
      ]
    }
  },
  "redirects": [
    {
      "source": "/api-reference/billing",
      "destination": "/api-reference/recurring"
    },
    {
      "source": "/ledger/:slug*",
      "destination": "/"
    }
  ],
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://docs.southpay.io"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@southpay.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://api.southpay.io"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/southpay",
      "linkedin": "https://linkedin.com/company/southpay"
    }
  },
  "appearance": {
    "strict": true,
    "default": "light"
  },
  "thumbnails": {
    "appearance": "light"
  },
  "banner": {
    "content": "SouthPay Documentation",
    "dismissible": false
  }
}
